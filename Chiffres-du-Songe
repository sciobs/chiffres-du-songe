<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Chiffres du Songe - Reves et numeros porte-bonheur</title>
<meta name="description" content="Entrez votre reve ou un mot, recevez un chiffre final et des numeros selon la tradition et un systeme de calcul propre a l'application.">
<style>
*{box-sizing:border-box;margin:0;padding:0;}
@keyframes drift{
0%{transform:translateY(0px);}
50%{transform:translateY(-8px);}
100%{transform:translateY(0px);}
}
@keyframes popIn{
0%{transform:scale(0.3) rotate(-10deg);opacity:0;}
70%{transform:scale(1.12) rotate(4deg);opacity:1;}
100%{transform:scale(1) rotate(0deg);opacity:1;}
}
@keyframes glow{
0%,100%{box-shadow:0 0 30px 8px rgba(217,164,65,0.35);}
50%{box-shadow:0 0 48px 14px rgba(217,164,65,0.55);}
}
body{
background:radial-gradient(circle at 50% 0%, #241238 0%, #150a24 45%, #0a0614 100%);
color:#f6ecff;
font-family:'Georgia', 'Times New Roman', serif;
min-height:100vh;
padding:0;
overflow-x:hidden;
}
.stars{
position:fixed;
inset:0;
background-image:
radial-gradient(1.5px 1.5px at 20px 30px, #ffe9a8 50%, transparent 100%),
radial-gradient(1.5px 1.5px at 130px 80px, #ffe9a8 50%, transparent 100%),
radial-gradient(1px 1px at 90px 160px, #ffd76b 50%, transparent 100%),
radial-gradient(1.5px 1.5px at 200px 210px, #ffe9a8 50%, transparent 100%),
radial-gradient(1px 1px at 250px 60px, #ffd76b 50%, transparent 100%),
radial-gradient(1.5px 1.5px at 300px 150px, #ffe9a8 50%, transparent 100%);
background-repeat:repeat;
background-size:320px 260px;
opacity:0.5;
pointer-events:none;
z-index:0;
}
.wrap{max-width:480px;margin:0 auto;padding:30px 18px 60px;position:relative;z-index:1;}
header{text-align:center;padding:10px 0 26px;}
.moon{
width:56px;height:56px;
margin:0 auto 14px;
border-radius:50%;
background:radial-gradient(circle at 35% 35%, #ffe9a8, #d9a441 70%, #a4761f 100%);
box-shadow:0 0 30px 6px rgba(217,164,65,0.45);
animation:drift 5s ease-in-out infinite;
}
header .mark{
font-size:12px;
letter-spacing:2.5px;
color:#d9a441;
margin-bottom:10px;
text-transform:uppercase;
}
h1{
font-size:2rem;
background:linear-gradient(90deg, #ffe9a8, #d9a441, #ffe9a8);
-webkit-background-clip:text;
background-clip:text;
color:transparent;
font-weight:700;
margin-bottom:10px;
background-size:200% auto;
}
header p{
color:#c9b8dd;
font-size:0.95rem;
max-width:32ch;
margin:0 auto;
}
.card{
background:linear-gradient(160deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02));
border:1px solid rgba(217,164,65,0.35);
border-radius:18px;
padding:24px;
margin-top:22px;
backdrop-filter:blur(6px);
box-shadow:0 10px 40px rgba(0,0,0,0.35);
}
label{
display:block;
font-size:0.85rem;
color:#d9a441;
margin-bottom:10px;
letter-spacing:0.3px;
}
input[type=text]{
width:100%;
padding:16px;
font-size:1.1rem;
border-radius:12px;
border:1px solid rgba(217,164,65,0.4);
background:rgba(10,6,20,0.55);
color:#f6ecff;
font-family:inherit;
}
input[type=text]::placeholder{color:#8577a3;}
input[type=text]:focus{outline:none;border-color:#d9a441;box-shadow:0 0 0 3px rgba(217,164,65,0.25);}
button{
width:100%;
margin-top:16px;
padding:17px;
font-size:1.05rem;
font-weight:700;
letter-spacing:0.3px;
border:none;
border-radius:12px;
background:linear-gradient(90deg, #d9a441, #f0c869, #d9a441);
background-size:200% auto;
color:#2a1806;
cursor:pointer;
box-shadow:0 6px 20px rgba(217,164,65,0.35);
transition:transform .15s ease, box-shadow .15s ease;
}
button:hover{background-position:right center;}
button:active{transform:scale(0.97);box-shadow:0 3px 10px rgba(217,164,65,0.3);}
.input-warning{
color:#e88a6b;
font-size:0.85rem;
margin-top:12px;
text-align:center;
}
.results{margin-top:24px;display:none;}
.results.show{display:block;}

.final-block{
text-align:center;
background:linear-gradient(160deg, rgba(217,164,65,0.14), rgba(157,120,255,0.10));
border:1px solid rgba(217,164,65,0.5);
border-radius:20px;
padding:26px 18px;
margin-bottom:18px;
}
.final-label{
font-size:0.8rem;
letter-spacing:2px;
text-transform:uppercase;
color:#e3c98b;
margin-bottom:14px;
}
.final-num{
width:96px;height:96px;
margin:0 auto 12px;
border-radius:50%;
display:flex;
align-items:center;
justify-content:center;
font-size:2.6rem;
font-weight:700;
color:#2a1806;
background:radial-gradient(circle at 35% 30%, #fff3d2, #d9a441 75%);
animation:popIn 0.5s cubic-bezier(.34,1.56,.64,1) backwards, glow 2.6s ease-in-out infinite;
}
.final-sub{
color:#c9b8dd;
font-size:0.85rem;
max-width:34ch;
margin:0 auto;
line-height:1.4;
}

.result-block{
background:linear-gradient(160deg, rgba(255,255,255,0.05), rgba(255,255,255,0.01));
border:1px solid rgba(255,255,255,0.08);
border-radius:16px;
padding:18px;
margin-bottom:16px;
}
.result-block.trad{border-color:rgba(217,164,65,0.35);}
.result-block.own{border-color:rgba(157,120,255,0.4);}
.result-block h2{
font-size:0.95rem;
margin-bottom:14px;
font-weight:700;
display:flex;
align-items:center;
gap:8px;
}
.result-block.trad h2{color:#d9a441;}
.result-block.own h2{color:#b79bff;}
.numbers{
display:flex;
flex-wrap:wrap;
gap:12px;
}
.num{
width:52px;
height:52px;
border-radius:50%;
display:flex;
align-items:center;
justify-content:center;
font-weight:700;
font-size:1.2rem;
animation:popIn 0.45s cubic-bezier(.34,1.56,.64,1) backwards;
}
.trad .num{
background:radial-gradient(circle at 35% 30%, #ffe9a8, #d9a441 75%);
color:#2a1806;
box-shadow:0 4px 14px rgba(217,164,65,0.4);
}
.own .num{
background:radial-gradient(circle at 35% 30%, #d9c8ff, #9d78ff 75%);
color:#1f0f3d;
box-shadow:0 4px 14px rgba(157,120,255,0.4);
}
.note{
color:#9a8bb5;
font-size:0.82rem;
margin-top:12px;
line-height:1.4;
}
.empty-msg{
color:#9a8bb5;
font-size:0.9rem;
padding:6px 0;
}
footer{
text-align:center;
color:#5f5578;
font-size:0.78rem;
margin-top:34px;
line-height:1.7;
}
@media (prefers-reduced-motion: reduce){
*{animation:none !important;transition:none !important;}
}
</style>
</head>
<body>
<div class="stars"></div>
<div class="wrap">
<header>
<div class="moon"></div>
<div class="mark">Chiffres du Songe</div>
<h1>Quel est ton reve ?</h1>
<p>Ecris un mot ou raconte ton reve, recois ta prediction.</p>
</header>

<div class="card">
<label for="dreamInput">Ton reve ou un mot</label>
<input type="text" id="dreamInput" placeholder="Exemple : serpent, mariage, argent..." autocomplete="off">
<button id="revealBtn">Reveler mon chiffre</button>
<div class="input-warning" id="inputWarning" style="display:none;">Ecris au moins un mot avec des lettres pour continuer.</div>
</div>

<div class="results" id="resultsBox">
<div class="final-block">
<div class="final-label">Ton chiffre du jour</div>
<div class="final-num" id="finalNum">--</div>
<div class="final-sub">Ne joue jamais plus que ce que tu peux te permettre de perdre.</div>
</div>

<div class="result-block trad">
<h2>Selon la tradition</h2>
<div class="numbers" id="traditionalNums"></div>
<div class="note" id="traditionalNote"></div>
</div>
<div class="result-block own">
<h2>Selon le calcul du Songe</h2>
<div class="numbers" id="ownNums"></div>
<div class="note">Calcule a partir des lettres exactes de ton texte. Change un seul mot et les chiffres changent.</div>
</div>
</div>

<footer>
Pour se divertir seulement. Aucune garantie de gain.<br>
Chiffres du Songe
</footer>
</div>

<script>
const TRADITIONAL_DICT = {"femme": 8, "homme": 3, "eau": 10, "poisson": 44, "serpent": 33, "argent": 27, "mort": 4, "naissance": 1, "mariage": 55, "voiture": 71, "avion": 60, "chien": 6, "chat": 22, "bebe": 2, "sang": 17, "feu": 5, "voleur": 39, "police": 28, "eglise": 66, "mosquee": 67, "roi": 21, "reine": 9, "or": 24, "diamant": 88, "pluie": 12, "soleil": 15, "lune": 20, "etoile": 25, "montagne": 34, "riviere": 48, "foret": 52, "marche": 63, "president": 90, "medecin": 41, "ecole": 45, "enfant": 7, "vieillard": 70, "accident": 80, "voyage": 61, "cadeau": 26, "fete": 30, "danse": 35, "musique": 46, "chanson": 47, "pain": 11, "riz": 13, "poulet": 18, "boeuf": 19, "chevre": 23, "mouton": 29, "oiseau": 31, "vol": 37, "chute": 38, "combat": 42, "victoire": 56, "defaite": 40, "ami": 49, "ennemi": 43, "famille": 50, "maison": 32, "porte": 36, "cle": 53, "route": 54, "pont": 57, "bateau": 58, "ile": 59, "tombeau": 62, "fantome": 64, "reve": 65, "prison": 68, "juge": 69, "avocat": 72, "banque": 74, "travail": 75, "chomage": 76, "maladie": 77, "guerison": 78, "grossesse": 79, "jumeaux": 81, "fou": 82, "sage": 83, "lion": 84, "aigle": 85, "tigre": 86, "elephant": 87, "singe": 89, "tortue": 14, "crocodile": 16, "requin": 51};

function normalize(s){
return s.toLowerCase()
.normalize('NFD').replace(/[\u0300-\u036f]/g,'')
.trim();
}

function traditionalLookup(text){
const clean = normalize(text);
const words = clean.split(/[^a-z]+/).filter(Boolean);
const found = [];
for (const w of words){
let word = w;
if (TRADITIONAL_DICT[word] === undefined && word.length > 1 && word.endsWith('s')){
word = word.slice(0, -1);
}
if (TRADITIONAL_DICT[word] !== undefined && !found.includes(TRADITIONAL_DICT[word])){
found.push(TRADITIONAL_DICT[word]);
}
}
return found.slice(0, 5);
}

function ownSystemNumbers(text) {
const clean = normalize(text).replace(/[^a-z]/g,'');
if (!clean) return [];
let charSum = 0;
for (let i = 0; i < clean.length; i++) {
charSum += clean.charCodeAt(i) * (i + 1);
}
const vowels = (clean.match(/[aeiouy]/g) || []).length;
const consonants = clean.length - vowels;
const length = clean.length;

const seeds = [
charSum,
charSum + vowels * 7,
charSum + consonants * 5,
charSum + length * 13,
charSum + (vowels * consonants + 3)
];

let numbers = seeds.map(s => {
let n = s % 90;
return n === 0 ? 90 : n;
});

const seen = new Set();
const result = [];
for (let n of numbers) {
while (seen.has(n)) {
n = (n % 90) + 1;
}
seen.add(n);
result.push(n);
}
return result;
}

function computeFinalNumber(tradNums, ownNums){
const a = tradNums.length ? tradNums[0] : (ownNums.length ? ownNums[0] : 7);
const b = ownNums.length ? ownNums[0] : (tradNums.length ? tradNums[0] : 21);
let n = (a + b) % 90;
return n === 0 ? 90 : n;
}

function renderNums(container, arr){
container.innerHTML = '';
arr.forEach((n, i) => {
const div = document.createElement('div');
div.className = 'num';
div.textContent = n;
div.style.animationDelay = (i * 0.08) + 's';
container.appendChild(div);
});
}

document.getElementById('revealBtn').addEventListener('click', () => {
const text = document.getElementById('dreamInput').value;
const resultsBox = document.getElementById('resultsBox');
const tradNote = document.getElementById('traditionalNote');
const warning = document.getElementById('inputWarning');

if (!text.trim() || !/[a-z]/i.test(text)){
resultsBox.classList.remove('show');
warning.style.display = 'block';
return;
}
warning.style.display = 'none';

const tradNums = traditionalLookup(text);
const ownNums = ownSystemNumbers(text);
const finalNumber = computeFinalNumber(tradNums, ownNums);

const finalEl = document.getElementById('finalNum');
finalEl.textContent = finalNumber;
finalEl.style.animation = 'none';
void finalEl.offsetWidth;
finalEl.style.animation = '';

if (tradNums.length > 0){
renderNums(document.getElementById('traditionalNums'), tradNums);
tradNote.textContent = "D'apres les mots reconnus dans ton texte.";
} else {
document.getElementById('traditionalNums').innerHTML = '';
tradNote.innerHTML = '<span class="empty-msg">Aucun mot reconnu dans la liste traditionnelle. Essaie un mot comme serpent, argent ou mariage.</span>';
}

renderNums(document.getElementById('ownNums'), ownNums);
resultsBox.classList.add('show');
});

document.getElementById('dreamInput').addEventListener('keypress', (e) => {
if (e.key === 'Enter'){
document.getElementById('revealBtn').click();
}
});
</script>
</body>
</html>
